<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fenêtre de l'assistant -->
    <record id="view_product_barcode_print_wizard_form" model="ir.ui.view">
        <field name="name">product.barcode.print.wizard.form</field>
        <field name="model">product.barcode.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer des codes-barres">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="quantity"/>
                </group>
                <group string="Contenu de l'étiquette">
                    <field name="show_name"/>
                    <field name="show_reference"/>
                    <field name="show_digits"/>
                    <field name="show_price"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimer" class="btn-primary"/>
                    <button name="action_download" type="object" string="Télécharger (.bin)" class="btn-secondary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action depuis les modèles de produit (menu Action) -->
    <record id="action_barcode_print_template" model="ir.actions.act_window">
        <field name="name">Imprimer code-barre</field>
        <field name="res_model">product.barcode.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form,list</field>
    </record>

    <!-- Même action depuis les variantes -->
    <record id="action_barcode_print_product" model="ir.actions.act_window">
        <field name="name">Imprimer code-barre</field>
        <field name="res_model">product.barcode.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo>
